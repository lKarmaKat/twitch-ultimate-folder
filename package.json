{
  "name": "twitch-ultimate-folder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "c:build": "rm -r dist/ && vite build",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/service_worker/configManage/configManage.test.js && npm run test:e2e",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:svelte": "npx vitest",
    "e2e": "npx playwright test",
    "e2e:headed": "npx playwright test --headed",
    "e2e:chromium": "npx playwright test --project=chromium",
    "e2e:chromium-beta": "npx playwright test --project=chromium-beta",
    "e2e:msedge": "npx playwright test --project=msedge",
    "e2e:firefox": "npx playwright test --project=firefox",
    "e2e:webkit": "npx playwright test --project=webkit"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "@playwright/test": "^1.58.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@tsconfig/svelte": "^5.0.6",
    "@types/chrome": "^0.1.32",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/sinon": "^21.0.0",
    "babel-jest": "^30.2.0",
    "jest-chrome": "^0.8.0",
    "jest-webextension-mock": "^4.0.0",
    "jsdom": "^27.4.0",
    "sinon": "^21.0.1",
    "sinon-chrome": "^3.0.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.3.4",
    "svelte-jester": "^5.0.0",
    "svelte-preprocess": "^6.0.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^3.1.4",
    "vite-plugin-web-extension": "^4.5.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "svelte-dnd-action": "^0.9.69"
  }
}
