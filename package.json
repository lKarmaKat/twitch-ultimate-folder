{
  "name": "twitch-ultimate-folder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "cross-env TARGET_BROWSER=chrome BUILD_PASS=main vite build --mode production && cross-env TARGET_BROWSER=chrome BUILD_PASS=content vite build --mode production",
    "build:firefox": "cross-env TARGET_BROWSER=firefox BUILD_PASS=main vite build --mode production && cross-env TARGET_BROWSER=firefox BUILD_PASS=content vite build --mode production",
    "build:dev": "cross-env TARGET_BROWSER=chrome BUILD_PASS=main vite build --mode development && cross-env TARGET_BROWSER=chrome BUILD_PASS=content vite build --mode development",
    "watch": "node scripts/watch.mjs",
    "watch:firefox": "cross-env TARGET_BROWSER=firefox node scripts/watch.mjs",
    "c:build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage tests/service_worker/configManager/configManager.test.ts",
    "e2e": "npx playwright test",
    "e2e:headed": "npx playwright test --headed",
    "e2e:chromium": "npx playwright test --project=chromium",
    "e2e:chromium-beta": "npx playwright test --project=chromium-beta",
    "e2e:msedge": "npx playwright test --project=msedge",
    "e2e:firefox": "npx playwright test --project=firefox",
    "e2e:webkit": "npx playwright test --project=webkit"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "@playwright/test": "^1.58.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.6",
    "@types/chrome": "^0.1.32",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "babel-jest": "^30.2.0",
    "cross-env": "^10.1.0",
    "jest-chrome": "^0.8.0",
    "jest-webextension-mock": "^4.0.0",
    "jsdom": "^27.4.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.3.4",
    "svelte-preprocess": "^6.0.3",
    "terser": "^5.48.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^3.1.4",
    "vite-plugin-web-extension": "^4.5.0"
  },
  "dependencies": {
    "svelte-dnd-action": "^0.9.69",
    "svelte-i18n": "^4.0.1"
  }
}
